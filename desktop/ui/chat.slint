// OffconAI Desktop — Chat transcript, tool approval gate, calm empty state, and composer.

import { ScrollView } from "std-widgets.slint";
import { ChatTurn, Ui } from "theme.slint";
import { Card, CompactButton, FlatButton, Glyph, SectionLabel, StatusDot } from "widgets.slint";

component ChatTurnView inherits VerticalLayout {
    in property <ChatTurn> turn;

    property <bool> is-user: turn.kind == 0;
    property <bool> is-assistant: turn.kind == 1;
    property <bool> is-reasoning: turn.kind == 2;
    property <bool> is-tool: turn.kind == 3;
    property <bool> is-error: turn.kind == 4;

    width: 100%;
    spacing: 4px;

    if is-user : HorizontalLayout {
        alignment: end;
        width: 100%;

        Rectangle {
            background: Ui.user-bubble;
            border-radius: 12px;
            border-width: 1px;
            border-color: Ui.hairline;
            max-width: parent.width * 0.85;

            VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 2px;

                Text {
                    text: turn.role;
                    font-size: 11px;
                    color: Ui.accent;
                    horizontal-alignment: right;
                }
                Text {
                    text: turn.body;
                    wrap: TextWrap.word-wrap;
                    font-size: 14px;
                    font-family: Ui.font-sans;
                    color: Ui.text;
                    horizontal-alignment: left;
                    line-height-factor: 1.4;
                }
            }
        }
    }

    if is-reasoning : Rectangle {
        background: Ui.reasoning-surface;
        border-radius: 8px;
        border-width: 1px;
        border-color: Ui.hairline;
        width: 100%;

        VerticalLayout {
            padding: 10px;
            spacing: 4px;

            Text {
                text: "💭 " + turn.role;
                font-size: 11px;
                font-family: Ui.font-mono;
                color: Ui.muted;
            }
            Text {
                text: turn.body;
                wrap: TextWrap.word-wrap;
                font-size: 12px;
                font-family: Ui.font-mono;
                color: Ui.muted;
                line-height-factor: 1.35;
            }
        }
    }

    if is-tool : Rectangle {
        background: Ui.tool-surface;
        border-radius: 8px;
        border-width: 1px;
        border-color: Ui.hairline;
        width: 100%;

        VerticalLayout {
            padding: 10px;
            spacing: 4px;

            Text {
                text: "🛠️ " + turn.role;
                font-size: 11px;
                font-family: Ui.font-mono;
                color: Ui.accent;
            }
            Text {
                text: turn.body;
                wrap: TextWrap.word-wrap;
                font-size: 11px;
                font-family: Ui.font-mono;
                color: Ui.text;
                line-height-factor: 1.35;
            }
        }
    }

    if is-assistant : VerticalLayout {
        width: 100%;
        spacing: 4px;

        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Text {
                text: turn.role;
                font-size: 11px;
                font-weight: 500;
                color: Ui.text;
            }
        }

        Text {
            width: 100%;
            text: turn.body;
            wrap: TextWrap.word-wrap;
            font-size: 14px;
            font-family: Ui.font-sans;
            color: Ui.text;
            line-height-factor: 1.4;
        }
    }

    if is-error : Rectangle {
        background: Ui.surface;
        border-radius: 8px;
        border-width: 1px;
        border-color: Ui.error;
        width: 100%;

        VerticalLayout {
            padding: 10px;
            spacing: 4px;

            Text {
                text: "⚠️ " + turn.role;
                font-size: 11px;
                font-weight: 500;
                color: Ui.error;
            }
            Text {
                text: turn.body;
                wrap: TextWrap.word-wrap;
                font-size: 12px;
                color: Ui.error;
                line-height-factor: 1.35;
            }
        }
    }
}

component Transcript inherits Rectangle {
    in property <[ChatTurn]> turns;
    in property <int> scroll-tick;

    property <bool> pinned: true;
    property <bool> scroll-pending: false;
    background: transparent;

    scroll := ScrollView {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

        scrolled => {
            root.pinned = scroll.content-y <= scroll.visible-height - scroll.content-height + 8px;
        }

        VerticalLayout {
            width: scroll.visible-width;
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 16px;
            padding-bottom: 16px;
            spacing: 16px;

            for turn in root.turns : ChatTurnView {
                turn: turn;
            }
        }
    }

    changed scroll-tick => {
        root.scroll-pending = true;
    }

    Timer {
        interval: 16ms;
        running: root.scroll-pending;
        triggered => {
            root.scroll-pending = false;
            if (root.pinned) {
                scroll.content-y = min(0px, scroll.visible-height - scroll.content-height);
            }
        }
    }
}

export component ChatWorkspace inherits VerticalLayout {
    in property <[ChatTurn]> turns;
    in property <int> scroll-tick;
    in property <string> model-indicator;
    in property <string> endpoint-name;
    in property <string> empty-engine;
    in property <bool> model-loaded;
    in property <bool> busy;
    in property <bool> awaiting-tool-approval;
    in property <string> pending-tool-title;
    in property <string> pending-tool-args;
    in-out property <string> input-text;

    callback send-requested();
    callback stop-requested();
    callback approve-tool-requested();
    callback decline-tool-requested();
    callback export-chat-requested();
    callback export-json-requested();
    callback copy-transcript-requested();
    callback clear-chat-requested();

    spacing: 8px;
    horizontal-stretch: 1;
    vertical-stretch: 1;

    HorizontalLayout {
        height: 24px;
        spacing: 8px;
        alignment: start;

        Rectangle {
            width: 6px;
            height: 24px;
            background: transparent;
            StatusDot {
                y: 9px;
                active: root.model-loaded;
            }
        }
        Text {
            text: root.model-indicator;
            font-size: 11px;
            font-family: Ui.font-mono;
            color: Ui.muted;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; background: transparent; }
        if root.turns.length > 0 : CompactButton {
            label: "Export .md";
            button-enabled: !root.busy;
            clicked => { root.export-chat-requested(); }
        }
        if root.turns.length > 0 : CompactButton {
            label: "Export .json";
            button-enabled: !root.busy;
            clicked => { root.export-json-requested(); }
        }
        if root.turns.length > 0 : CompactButton {
            label: "Copy All";
            button-enabled: !root.busy;
            clicked => { root.copy-transcript-requested(); }
        }
        if root.turns.length > 0 : CompactButton {
            label: "Clear";
            button-enabled: !root.busy;
            clicked => { root.clear-chat-requested(); }
        }
        Text {
            text: root.endpoint-name;
            font-size: 11px;
            font-family: Ui.font-mono;
            color: Ui.muted;
            vertical-alignment: center;
        }
    }

    Card {
        horizontal-stretch: 1;
        vertical-stretch: 1;

        if root.turns.length == 0 : VerticalLayout {
            width: 100%;
            height: 100%;
            padding: 32px;
            spacing: 0;
            alignment: start;

            Glyph { glyph-size: 26px; }
            Rectangle { height: 16px; background: transparent; }
            Text {
                text: "No conversation";
                font-size: 16px;
                font-weight: 500;
                color: Ui.text;
            }
            Rectangle { height: 6px; background: transparent; }
            Text {
                text: "Connect a local llama.cpp process or an OpenAI-compatible runtime, then send a prompt.";
                font-size: 12px;
                color: Ui.muted;
            }
            Rectangle { height: 22px; background: transparent; }
            Rectangle {
                width: 340px;
                height: 70px;
                background: Ui.raised;
                border-radius: 10px;
                border-width: 1px;
                border-color: Ui.hairline;

                VerticalLayout {
                    padding: 12px;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Rectangle {
                            width: 6px;
                            height: 14px;
                            background: transparent;
                            StatusDot {
                                y: 4px;
                                active: root.model-loaded;
                            }
                        }
                        SectionLabel { text: "Engine"; }
                    }
                    Text {
                        text: root.empty-engine;
                        font-size: 11px;
                        font-family: Ui.font-mono;
                        color: Ui.text;
                        overflow: elide;
                    }
                }
            }
        }

        Transcript {
            width: 100%;
            height: 100%;
            visible: root.turns.length > 0;
            turns: root.turns;
            scroll-tick: root.scroll-tick;
        }
    }

    if root.awaiting-tool-approval : Rectangle {
        background: Ui.surface;
        border-radius: 12px;
        border-width: 1px;
        border-color: Ui.accent;

        HorizontalLayout {
            padding: 12px;
            spacing: 12px;
            alignment: stretch;

            VerticalLayout {
                spacing: 4px;
                horizontal-stretch: 1;
                Text {
                    text: root.pending-tool-title;
                    font-size: 12px;
                    font-weight: 500;
                    color: Ui.text;
                    overflow: elide;
                }
                tool-args-scroll := ScrollView {
                    width: 100%;
                    height: 64px;
                    vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

                    Text {
                        width: tool-args-scroll.visible-width;
                        text: root.pending-tool-args;
                        wrap: TextWrap.word-wrap;
                        font-size: 11px;
                        font-family: Ui.font-mono;
                        color: Ui.muted;
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                FlatButton {
                    label: "Decline";
                    height: 32px;
                    button-enabled: root.awaiting-tool-approval;
                    clicked => { root.decline-tool-requested(); }
                }
                FlatButton {
                    label: "Run tool";
                    primary: true;
                    height: 32px;
                    button-enabled: root.awaiting-tool-approval;
                    clicked => { root.approve-tool-requested(); }
                }
            }
        }
    }

    Rectangle {
        height: 96px;
        background: Ui.surface;
        border-radius: 12px;
        border-width: 1px;
        border-color: composer-input.has-focus ? Ui.accent : Ui.hairline;

        composer-input := TextInput {
            x: 14px;
            y: 10px;
            width: parent.width - 28px;
            height: 52px;
            text <=> root.input-text;
            single-line: false;
            wrap: TextWrap.word-wrap;
            font-size: 14px;
            font-family: Ui.font-sans;
            color: Ui.text;
            enabled: !root.busy && !root.awaiting-tool-approval;
            selection-background-color: Ui.accent;
            selection-foreground-color: #FFFFFF;
            accessible-label: "Message prompt";
            accessible-placeholder-text: "Write a prompt...";
            key-pressed(event) => {
                if (event.text == "\n" && !event.modifiers.shift && !root.busy && !root.awaiting-tool-approval) {
                    root.send-requested();
                    return accept;
                }
                return reject;
            }
        }

        Text {
            x: 15px;
            y: 10px;
            width: parent.width - 30px;
            height: 22px;
            text: root.input-text == "" ? "Write a prompt..." : "";
            font-size: 14px;
            color: Ui.muted;
            vertical-alignment: center;
            accessible-role: none;
        }

        HorizontalLayout {
            x: 14px;
            y: parent.height - 34px;
            width: parent.width - 28px;
            height: 26px;
            spacing: 8px;
            alignment: end;

            Text {
                text: "Enter sends \u{00B7} Shift+Enter new line";
                font-size: 11px;
                color: Ui.muted;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }

            if root.busy : FlatButton {
                label: "Stop";
                button-enabled: true;
                height: 26px;
                clicked => { root.stop-requested(); }
            }
            FlatButton {
                label: "Send";
                primary: true;
                button-enabled: !root.busy && !root.awaiting-tool-approval;
                height: 26px;
                clicked => { root.send-requested(); }
            }
        }
    }
}
