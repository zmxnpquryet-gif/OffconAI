// OffconAI Desktop — runtime, engine guide, model catalog & MCP tools sidebar.

import { ComboBox, ScrollView } from "std-widgets.slint";
import { Ui } from "theme.slint";
import { Card, CheckRow, Field, FieldLabel, FlatButton, ProgressLine, SectionLabel, StatusDot } from "widgets.slint";

export component RuntimeSidebar inherits Rectangle {
    in-out property <int> backend-index;
    in property <bool> busy;
    in property <bool> model-loaded;
    in property <bool> mcp-connected;
    in property <string> mcp-status;

    in property <string> engine-info;
    in property <[string]> catalog-labels;
    in-out property <int> catalog-index;
    in property <string> catalog-note;
    in property <bool> download-active;
    in property <float> download-progress;
    in property <string> download-status;

    in property <bool> advanced-open;
    in-out property <bool> use-manual-model;

    in-out property <string> model-label;
    in-out property <string> llama-executable;
    in-out property <string> llama-model-path;
    in-out property <string> llama-port;
    in-out property <string> llama-context-size;
    in-out property <string> llama-gpu-layers;

    in-out property <string> vllm-endpoint;
    in-out property <string> vllm-model-path;
    in-out property <string> vllm-port;
    in-out property <bool> vllm-managed;

    in-out property <string> strata-endpoint;
    in-out property <string> strata-launch;

    in-out property <string> temperature-text;
    in-out property <string> max-tokens-text;

    in-out property <string> mcp-url;
    in-out property <string> mcp-token;

    callback load-requested();
    callback unload-requested();
    callback new-chat-requested();
    callback catalog-selected(int);
    callback engine-changed();
    callback advanced-toggled();
    callback mcp-connect-requested();
    callback mcp-disconnect-requested();

    width: 300px;
    background: transparent;

    scroll := ScrollView {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

        VerticalLayout {
            width: scroll.visible-width;
            spacing: 8px;
            alignment: start;

            SectionLabel { text: "Runtime"; }
            Card {
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    FieldLabel { text: "Engine"; }
                    ComboBox {
                        height: 34px;
                        model: [
                            "llama.cpp \u{00B7} zero-setup",
                            "vLLM \u{00B7} max throughput",
                            "Strata \u{00B7} gateway",
                        ];
                        current-index <=> root.backend-index;
                        enabled: !root.busy;
                        selected => {
                            root.engine-changed();
                        }
                    }
                    Text {
                        text: root.engine-info;
                        wrap: TextWrap.word-wrap;
                        font-size: 11px;
                        color: Ui.muted;
                    }

                    VerticalLayout {
                        spacing: 4px;
                        FieldLabel { text: "Model"; }
                        ComboBox {
                            height: 34px;
                            model: root.catalog-labels;
                            current-index <=> root.catalog-index;
                            enabled: !root.busy;
                            selected => {
                                root.catalog-selected(self.current-index);
                            }
                        }
                    }
                    Text {
                        text: root.catalog-note;
                        wrap: TextWrap.word-wrap;
                        font-size: 11px;
                        font-family: Ui.font-mono;
                        color: Ui.muted;
                    }

                    if root.download-active : VerticalLayout {
                        spacing: 4px;
                        ProgressLine {
                            height: 8px;
                            progress: root.download-progress;
                        }
                        Text {
                            text: root.download-status;
                            font-size: 11px;
                            font-family: Ui.font-mono;
                            color: Ui.text;
                            overflow: elide;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        height: 36px;

                        FlatButton {
                            label: "Load";
                            primary: true;
                            button-enabled: !root.busy;
                            horizontal-stretch: 1;
                            clicked => { root.load-requested(); }
                        }
                        FlatButton {
                            label: "Unload";
                            button-enabled: !root.busy && root.model-loaded;
                            horizontal-stretch: 1;
                            clicked => { root.unload-requested(); }
                        }
                    }

                    FlatButton {
                        label: "New conversation";
                        button-enabled: !root.busy;
                        height: 32px;
                        clicked => { root.new-chat-requested(); }
                    }
                }
            }

            Rectangle { height: 2px; background: transparent; }
            Card {
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    FlatButton {
                        label: root.advanced-open ? "Hide advanced settings" : "Show advanced settings";
                        height: 30px;
                        button-enabled: !root.busy;
                        clicked => { root.advanced-toggled(); }
                    }

                    if root.advanced-open && root.backend-index == 0 : VerticalLayout {
                        spacing: 8px;
                        CheckRow {
                            checked <=> root.use-manual-model;
                            label: "Use manual GGUF path instead of the list";
                            row-enabled: !root.busy;
                        }
                        VerticalLayout {
                            spacing: 4px;
                            FieldLabel { text: "GGUF model path"; }
                            Field {
                                text <=> root.llama-model-path;
                                placeholder: "C:\\models\\model.gguf";
                                field-enabled: !root.busy;
                                monospace: true;
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            FieldLabel { text: "llama-server binary"; }
                            Field {
                                text <=> root.llama-executable;
                                placeholder: "llama-server (bundled)";
                                field-enabled: !root.busy;
                                monospace: true;
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                spacing: 4px;
                                horizontal-stretch: 1;
                                FieldLabel { text: "Port"; }
                                Field {
                                    text <=> root.llama-port;
                                    placeholder: "8080";
                                    field-enabled: !root.busy;
                                    monospace: true;
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                horizontal-stretch: 1;
                                FieldLabel { text: "Context"; }
                                Field {
                                    text <=> root.llama-context-size;
                                    placeholder: "4096";
                                    field-enabled: !root.busy;
                                    monospace: true;
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                horizontal-stretch: 1;
                                FieldLabel { text: "GPU layers"; }
                                Field {
                                    text <=> root.llama-gpu-layers;
                                    placeholder: "0";
                                    field-enabled: !root.busy;
                                    monospace: true;
                                }
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            FieldLabel { text: "Model label / served id"; }
                            Field {
                                text <=> root.model-label;
                                placeholder: "auto from selection";
                                field-enabled: !root.busy;
                                monospace: true;
                            }
                        }
                    }

                    if root.advanced-open && root.backend-index == 1 : VerticalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            spacing: 4px;
                            FieldLabel { text: "Endpoint"; }
                            Field {
                                text <=> root.vllm-endpoint;
                                placeholder: "http://127.0.0.1:8000";
                                field-enabled: !root.busy;
                                monospace: true;
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            FieldLabel { text: "Model path / Hugging Face id"; }
                            Field {
                                text <=> root.vllm-model-path;
                                placeholder: "Qwen/Qwen3-8B";
                                field-enabled: !root.busy;
                                monospace: true;
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                spacing: 4px;
                                width: 96px;
                                FieldLabel { text: "Port"; }
                                Field {
                                    text <=> root.vllm-port;
                                    placeholder: "8000";
                                    field-enabled: !root.busy;
                                    monospace: true;
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                horizontal-stretch: 1;
                                FieldLabel { text: "Lifecycle"; }
                                CheckRow {
                                    checked <=> root.vllm-managed;
                                    label: "Spawn vLLM";
                                    row-enabled: !root.busy;
                                }
                            }
                        }
                    }

                    if root.advanced-open && root.backend-index == 2 : VerticalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            spacing: 4px;
                            FieldLabel { text: "Gateway endpoint"; }
                            Field {
                                text <=> root.strata-endpoint;
                                placeholder: "http://127.0.0.1:9000";
                                field-enabled: !root.busy;
                                monospace: true;
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            FieldLabel { text: "Launch command (optional)"; }
                            Field {
                                text <=> root.strata-launch;
                                placeholder: "strata serve --port 9000";
                                field-enabled: !root.busy;
                                monospace: true;
                            }
                        }
                    }
                }
            }

            Rectangle { height: 2px; background: transparent; }
            SectionLabel { text: "MCP Tools"; }
            Card {
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    VerticalLayout {
                        spacing: 4px;
                        FieldLabel { text: "MCP server URL"; }
                        Field {
                            text <=> root.mcp-url;
                            placeholder: "http://127.0.0.1:3000/mcp";
                            field-enabled: !root.busy;
                            monospace: true;
                        }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        FieldLabel { text: "Bearer token (optional)"; }
                        Field {
                            text <=> root.mcp-token;
                            placeholder: "token";
                            field-enabled: !root.busy;
                            monospace: true;
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        height: 32px;

                        FlatButton {
                            label: "Connect";
                            primary: true;
                            button-enabled: !root.busy;
                            height: 32px;
                            horizontal-stretch: 1;
                            clicked => { root.mcp-connect-requested(); }
                        }
                        FlatButton {
                            label: "Disconnect";
                            button-enabled: !root.busy && root.mcp-connected;
                            height: 32px;
                            horizontal-stretch: 1;
                            clicked => { root.mcp-disconnect-requested(); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Rectangle {
                            width: 6px;
                            height: 14px;
                            background: transparent;
                            StatusDot {
                                y: 4px;
                                active: root.mcp-connected;
                            }
                        }
                        Text {
                            text: root.mcp-status;
                            font-size: 11px;
                            font-family: Ui.font-mono;
                            color: Ui.muted;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }

            Rectangle { height: 2px; background: transparent; }
            SectionLabel { text: "Sampling"; }
            Card {
                HorizontalLayout {
                    padding: 12px;
                    spacing: 8px;

                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 1;
                        FieldLabel { text: "Temperature"; }
                        Field {
                            text <=> root.temperature-text;
                            placeholder: "0.7";
                            field-enabled: !root.busy;
                            monospace: true;
                        }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 1;
                        FieldLabel { text: "Max tokens"; }
                        Field {
                            text <=> root.max-tokens-text;
                            placeholder: "1024";
                            field-enabled: !root.busy;
                            monospace: true;
                        }
                    }
                }
            }

            Text {
                text: "Models and prompts stay on hardware you control.";
                font-size: 11px;
                color: Ui.muted;
            }
        }
    }
}
